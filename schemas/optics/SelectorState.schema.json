{
  "$id": "https://araucaria-project.github.io/datamodels/optics/SelectorState.schema.json",
  "additionalProperties": false,
  "description": "Proven state of one selector as the solver sees it. ``position=None`` means the readback\nmaps to no declared symbol (the oca-problems#107 case: M3 reports \"2\"); together with\n``moving`` and ``stale`` that is exactly what makes a path ``undefined``.",
  "properties": {
    "moving": {
      "default": false,
      "title": "Moving",
      "type": "boolean"
    },
    "position": {
      "anyOf": [
        {
          "not": {
            "enum": [
              "dark",
              "undefined"
            ]
          },
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Position"
    },
    "raw": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw"
    },
    "stale": {
      "default": false,
      "title": "Stale",
      "type": "boolean"
    }
  },
  "title": "SelectorState",
  "type": "object"
}
