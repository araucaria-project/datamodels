{
  "$id": "https://araucaria-project.github.io/datamodels/optics/Impossible.schema.json",
  "additionalProperties": false,
  "description": "No alternative of the goal can be provided now — typically the source class is\nunavailable (``sky.science`` in daytime) or every path crosses an ``undefined`` selector.",
  "properties": {
    "kind": {
      "const": "impossible",
      "title": "Kind",
      "type": "string"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "unavailable": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unavailable"
    },
    "undefined_at": {
      "default": [],
      "items": {
        "not": {
          "anyOf": [
            {
              "pattern": "^(dark|undefined)(\\.|$)"
            },
            {
              "pattern": "\\.(dark|undefined)$"
            }
          ]
        },
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$",
        "type": "string"
      },
      "title": "Undefined At",
      "type": "array"
    }
  },
  "required": [
    "kind",
    "reason"
  ],
  "title": "Impossible",
  "type": "object"
}
