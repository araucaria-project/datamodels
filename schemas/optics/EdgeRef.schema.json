{
  "$defs": {
    "PortOwner": {
      "description": "Who owns the port an edge is labelled with. Encodes the one edge-grammar invariant:\n*an edge label always names a port of the switch-owning component; the edge is live iff that\nowner currently emits on that port.*",
      "enum": [
        "upstream",
        "self"
      ],
      "title": "PortOwner",
      "type": "string"
    }
  },
  "$id": "https://araucaria-project.github.io/datamodels/optics/EdgeRef.schema.json",
  "additionalProperties": false,
  "description": "One normalized upstream edge. ``port`` is ``None`` for a passive edge; otherwise\n``port_owner`` says whose port it is (see :class:`PortOwner`).",
  "properties": {
    "component": {
      "not": {
        "enum": [
          "dark",
          "undefined"
        ]
      },
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Component",
      "type": "string"
    },
    "port": {
      "anyOf": [
        {
          "not": {
            "enum": [
              "dark",
              "undefined"
            ]
          },
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Port"
    },
    "port_owner": {
      "anyOf": [
        {
          "$ref": "#/$defs/PortOwner"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "component"
  ],
  "title": "EdgeRef",
  "type": "object"
}
