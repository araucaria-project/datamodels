{
  "$defs": {
    "Active": {
      "additionalProperties": false,
      "description": "The detector already sees the goal.",
      "properties": {
        "kind": {
          "const": "active",
          "title": "Kind",
          "type": "string"
        },
        "positions": {
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$": {
              "not": {
                "enum": [
                  "dark",
                  "undefined"
                ]
              },
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            }
          },
          "propertyNames": {
            "not": {
              "anyOf": [
                {
                  "pattern": "^(dark|undefined)(\\.|$)"
                },
                {
                  "pattern": "\\.(dark|undefined)$"
                }
              ]
            }
          },
          "title": "Positions",
          "type": "object"
        },
        "see": {
          "not": {
            "const": "undefined"
          },
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$",
          "title": "See",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "see"
      ],
      "title": "Active",
      "type": "object"
    },
    "Collision": {
      "additionalProperties": false,
      "description": "A required selector is held in a contradictory position. ``holder`` names who holds it when\nthe access grantor knows; the reason is human-readable and stable enough to display.",
      "properties": {
        "held": {
          "not": {
            "enum": [
              "dark",
              "undefined"
            ]
          },
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Held",
          "type": "string"
        },
        "holder": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holder"
        },
        "kind": {
          "const": "collision",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "required": {
          "not": {
            "enum": [
              "dark",
              "undefined"
            ]
          },
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Required",
          "type": "string"
        },
        "selector": {
          "not": {
            "anyOf": [
              {
                "pattern": "^(dark|undefined)(\\.|$)"
              },
              {
                "pattern": "\\.(dark|undefined)$"
              }
            ]
          },
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$",
          "title": "Selector",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "selector",
        "required",
        "held",
        "reason"
      ],
      "title": "Collision",
      "type": "object"
    },
    "ConfigError": {
      "additionalProperties": false,
      "description": "One load-time problem with the authored graph.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "component": {
          "anyOf": [
            {
              "not": {
                "enum": [
                  "dark",
                  "undefined"
                ]
              },
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Component"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ConfigError",
      "type": "object"
    },
    "Impossible": {
      "additionalProperties": false,
      "description": "No alternative of the goal can be provided now — typically the source class is\nunavailable (``sky.science`` in daytime) or every path crosses an ``undefined`` selector.",
      "properties": {
        "kind": {
          "const": "impossible",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "unavailable": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unavailable"
        },
        "undefined_at": {
          "default": [],
          "items": {
            "not": {
              "anyOf": [
                {
                  "pattern": "^(dark|undefined)(\\.|$)"
                },
                {
                  "pattern": "\\.(dark|undefined)$"
                }
              ]
            },
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$",
            "type": "string"
          },
          "title": "Undefined At",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "title": "Impossible",
      "type": "object"
    },
    "Invalid": {
      "additionalProperties": false,
      "description": "Config error. Raised at load/deploy time by ``parse_graph``; never a runtime surprise.",
      "properties": {
        "errors": {
          "items": {
            "$ref": "#/$defs/ConfigError"
          },
          "minItems": 1,
          "title": "Errors",
          "type": "array"
        },
        "kind": {
          "const": "invalid",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "errors"
      ],
      "title": "Invalid",
      "type": "object"
    },
    "Settable": {
      "additionalProperties": false,
      "description": "Not active, but these selector moves make it so. ``moves`` is the subset of ``positions``\nthat differs from the proven state.",
      "properties": {
        "kind": {
          "const": "settable",
          "title": "Kind",
          "type": "string"
        },
        "moves": {
          "additionalProperties": false,
          "minProperties": 1,
          "patternProperties": {
            "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$": {
              "not": {
                "enum": [
                  "dark",
                  "undefined"
                ]
              },
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            }
          },
          "propertyNames": {
            "not": {
              "anyOf": [
                {
                  "pattern": "^(dark|undefined)(\\.|$)"
                },
                {
                  "pattern": "\\.(dark|undefined)$"
                }
              ]
            }
          },
          "title": "Moves",
          "type": "object"
        },
        "positions": {
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$": {
              "not": {
                "enum": [
                  "dark",
                  "undefined"
                ]
              },
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            }
          },
          "propertyNames": {
            "not": {
              "anyOf": [
                {
                  "pattern": "^(dark|undefined)(\\.|$)"
                },
                {
                  "pattern": "\\.(dark|undefined)$"
                }
              ]
            }
          },
          "title": "Positions",
          "type": "object"
        },
        "see": {
          "not": {
            "const": "undefined"
          },
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$",
          "title": "See",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "see",
        "positions",
        "moves"
      ],
      "title": "Settable",
      "type": "object"
    }
  },
  "$id": "https://araucaria-project.github.io/datamodels/optics/Verdict.schema.json",
  "discriminator": {
    "mapping": {
      "active": "#/$defs/Active",
      "collision": "#/$defs/Collision",
      "impossible": "#/$defs/Impossible",
      "invalid": "#/$defs/Invalid",
      "settable": "#/$defs/Settable"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Active"
    },
    {
      "$ref": "#/$defs/Settable"
    },
    {
      "$ref": "#/$defs/Collision"
    },
    {
      "$ref": "#/$defs/Impossible"
    },
    {
      "$ref": "#/$defs/Invalid"
    }
  ]
}
