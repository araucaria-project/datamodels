{
  "$defs": {
    "GoalSpec": {
      "additionalProperties": false,
      "description": "The explicit goal form: *see this class, through these selector positions, when this\ncondition holds*. ``via`` pins the dark terminal (``dark_strict`` = railway flank\nprotection); ``when`` conditions the alternative on the sky state.",
      "properties": {
        "see": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$",
          "title": "See",
          "type": "string"
        },
        "via": {
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$": {
              "not": {
                "enum": [
                  "dark",
                  "undefined"
                ]
              },
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            }
          },
          "propertyNames": {
            "not": {
              "anyOf": [
                {
                  "pattern": "^(dark|undefined)(\\.|$)"
                },
                {
                  "pattern": "\\.(dark|undefined)$"
                }
              ]
            }
          },
          "title": "Via",
          "type": "object"
        },
        "when": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "When"
        }
      },
      "required": [
        "see"
      ],
      "title": "GoalSpec",
      "type": "object"
    }
  },
  "$id": "https://araucaria-project.github.io/datamodels/optics/DetectorPaths.schema.json",
  "additionalProperties": false,
  "description": "``paths:`` on a detector — functions mapped to goals. Function names from\n:class:`~datamodels.optics.vocabulary.CoreFunction` carry a reserved meaning; others are\nfree.",
  "patternProperties": {
    "^[a-z][a-z0-9_]*$": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$",
          "type": "string"
        },
        {
          "$ref": "#/$defs/GoalSpec"
        },
        {
          "items": {
            "anyOf": [
              {
                "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$",
                "type": "string"
              },
              {
                "$ref": "#/$defs/GoalSpec"
              }
            ]
          },
          "minItems": 1,
          "type": "array"
        }
      ]
    }
  },
  "title": "DetectorPaths",
  "type": "object"
}
