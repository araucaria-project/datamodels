{
  "$id": "https://araucaria-project.github.io/datamodels/optics/GoalSpec.schema.json",
  "additionalProperties": false,
  "description": "The explicit goal form: *see this class, through these selector positions, when this\ncondition holds*. ``via`` pins the dark terminal (``dark_strict`` = railway flank\nprotection); ``when`` conditions the alternative on the sky state.",
  "properties": {
    "see": {
      "not": {
        "const": "undefined"
      },
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$",
      "title": "See",
      "type": "string"
    },
    "via": {
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$": {
          "not": {
            "enum": [
              "dark",
              "undefined"
            ]
          },
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        }
      },
      "propertyNames": {
        "not": {
          "anyOf": [
            {
              "pattern": "^(dark|undefined)(\\.|$)"
            },
            {
              "pattern": "\\.(dark|undefined)$"
            }
          ]
        }
      },
      "title": "Via",
      "type": "object"
    },
    "when": {
      "anyOf": [
        {
          "not": {
            "const": "undefined"
          },
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "When"
    }
  },
  "required": [
    "see"
  ],
  "title": "GoalSpec",
  "type": "object"
}
